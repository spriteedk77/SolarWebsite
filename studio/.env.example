# Public identifiers for the NP88 Solar content project. Both values are safe
# in the repository and safe in the browser bundle — they name the project, they
# do not grant access to it. Copy this file to studio/.env.local as-is.
SANITY_STUDIO_PROJECT_ID=mtnue2wm
SANITY_STUDIO_DATASET=production
# Never put API tokens in SANITY_STUDIO_* variables (browser-visible).
