# Local and GitHub Pages previews use the versioned content snapshot.
# Netlify always uses Sanity; there is no content-source switch.
NEXT_PUBLIC_SITE_URL=https://www.np88solar.com
NEXT_PUBLIC_COPYRIGHT_YEAR=2026

# Server-only credentials. SANITY_READ_TOKEN is optional for the public dataset.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_READ_TOKEN=
# Admin and one-time hosted bootstrap; never put write tokens in browser vars.
SANITY_WRITE_TOKEN=

# Content admin at /admin. Generate both with `npm run admin:password`; the
# password itself is never stored anywhere. Without these the admin refuses
# every login rather than falling open.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Launch guard. Set to 1 to opt in manually; it is already automatic on
# Vercel (VERCEL_ENV=production) and Netlify (CONTEXT=production).
PRODUCTION_LAUNCH=
# HTTPS receiver persists private data + attachments before responding 2xx.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# CI only, never public preview/production.
LEAD_TEST_MODE=

# Local snapshot only. Live CMS reads these from the company document.
NEXT_PUBLIC_GBP_URL=
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Uploads: 4 MiB request, 3 MiB total files, 3 MiB/file, 8 files.
