# ---------------------------------------------------------------------------
# NP88 Solar — environment variables
# Copy to .env.local for development, and set the same keys in the host's
# environment for production. Never commit real values.
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, Open Graph, sitemap and JSON-LD.
# MUST be set in production or every absolute URL will point at the default.
NEXT_PUBLIC_SITE_URL=https://www.np88solar.com

# Where lead submissions go. Without this, /api/lead falls back to writing
# JSON files under ./.data/leads — development only, never production.
# Point it at a Make / Zapier / n8n / LINE Official Account webhook.
LEAD_WEBHOOK_URL=

# Enables /api/lead's testMode=1 shortcut (validates fully, delivers nothing).
# Set this ONLY in CI. Never set it in a real deployment's environment —
# next start always runs with NODE_ENV=production, so this is the only gate.
LEAD_TEST_MODE=

# Year printed in the footer copyright line. Every page is statically
# prerendered, so this is deliberately explicit rather than read from the clock
# at render time — bump it (or set it here) as part of the yearly release.
NEXT_PUBLIC_COPYRIGHT_YEAR=2026

# ---------------------------------------------------------------------------
# Request limits for /api/lead are enforced in code (30 MB request, 25 MB of
# attachments, 8 files, 10 MB each). Set a matching limit at the edge too:
#   nginx       client_max_body_size 30m;
#   Vercel      platform body limit applies automatically
#   Cloudflare  the plan's upload cap applies
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Local SEO — fill in once NP88 Solar confirms them.
# While empty, the site simply omits the map and the profile links rather than
# rendering a broken embed.
# ---------------------------------------------------------------------------

# Public link to the Google Business Profile.
NEXT_PUBLIC_GBP_URL=

# Google Maps EMBED url (the src of the iframe from "Share > Embed a map").
NEXT_PUBLIC_MAPS_EMBED_URL=

# Facebook page.
NEXT_PUBLIC_FACEBOOK_URL=
